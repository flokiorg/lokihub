# General Configuration
#WORK_DIR=./data
#PORT=1610
#DATABASE_URI=nwc.db
#NETWORK=flokicoin
#BASE_URL=http://localhost:1610
#FRONTEND_URL=http://localhost:5173

# Docker dev stack (docker-compose.dev.yml / `just dev`) — NOT read by the
# app itself, only by docker compose and the Justfile. Host-side path to
# flnd/hub data; defaults to ./data. Set to another checkout's data/ (e.g.
# the main checkout's, absolute path) to reuse its already-synced flnd
# wallet and hub DB from a worktree instead of syncing/setting up a second
# one from scratch. See `just dev help`.
#DEV_DATA_DIR=

# The flnd container builds against sibling checkouts (../flnd, ../walletd,
# ../flokicoin-neutrino by default) that only resolve correctly from the
# main checkout — a worktree lives deeper on disk, so the same relative
# path misses them. Set these three (absolute paths) in a worktree's .env;
# leave unset in the main checkout.
#DEV_FLND_DIR=
#DEV_WALLETD_DIR=
#DEV_FLOKICOIN_NEUTRINO_DIR=

# Logging
#Level 4 = Info, 5 = Debug
#LOG_LEVEL=4
#LOG_TO_FILE=true
#LOG_DB_QUERIES=false

# Security & Setup
#AUTO_UNLOCK_PASSWORD=
#ENABLE_ADVANCED_SETUP=true

# Services Configuration
#RELAY=wss://relay.ohstr.com
#MEMPOOL_API=https://flokichain.info/api
#SWAP_SERVICE_URL=
#LOKIHUB_SERVICES_URL=https://raw.githubusercontent.com/flokiorg/lokihub-services/refs/heads/main
#LOKIHUB_STORE_URL=https://raw.githubusercontent.com/flokiorg/lokihub-store/refs/heads/main
#MESSAGEBOARD_NWC_URL=

#ENABLE_SWAP=true
#ENABLE_MESSAGEBOARD_NWC=true

# FLND Configuration (Optional)
#LN_BACKEND_TYPE=FLND
#FLND_ADDRESS=
#FLND_CERT_FILE=
#FLND_MACAROON_FILE=

# Debugging
#GO_PROFILER_ADDR=