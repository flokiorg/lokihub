# Pins the Go toolchain version go.mod requires (go 1.26.10), so `just`
# recipes that shell out to `go`/`wails` don't need GOTOOLCHAIN=go1.26.10
# typed on the command line every time.
GOTOOLCHAIN=go1.26.10

# General Configuration
#WORK_DIR=./data
#PORT=1610
#DATABASE_URI=nwc.db
#NETWORK=flokicoin   (the dev stack sets regtest)
#BASE_URL=http://localhost:1610
#FRONTEND_URL=http://localhost:5173

# Docker dev stack (docker-compose.dev.yml / `just dev`): regtest only. Read by
# docker compose, the Justfile and integration/cmd/regtest.
#
# Unlock password of the dev Hub: `just dev bootstrap` sets lokihub up with it and
# the backend auto-unlocks with it. Dev only.
DEV_UNLOCK_PASSWORD=regtest-dev
# Host where docker publishes the stack's ports, as the host-run tools reach it
# (a hostname; it is added to the chain and flnd TLS certs).
#DEV_HOST=localhost
# Published ports. A worktree running its own stack also sets COMPOSE_PROJECT_NAME.
#CHAIN_RPC_PORT=25213
#FLND_RPC_PORT=10005
#PAYER_RPC_PORT=10006
#RELAY_PORT=5500
#CADDY_PORT=5610
# flspd, the test LSP (compose profile "lsp", on when the image exists):
#LSP_RPC_PORT=10007
#FLSPD_DASHBOARD_PORT=8090
#FLSPD_IMAGE=flspd:regtest
#COMPOSE_PROJECT_NAME=lokihub-dev

# The chain and flnd images build from sibling checkouts (../go-flokicoin,
# ../flnd, ../walletd, ../flokicoin-neutrino). A worktree lives deeper, so set
# these (absolute paths) in a worktree's .env.
#DEV_FLOKICOIN_DIR=
#DEV_FLND_DIR=
#DEV_WALLETD_DIR=
#DEV_FLOKICOIN_NEUTRINO_DIR=

# NWC rate limits: 0 disables a limit (the code defaults are 10/20/3 per hour).
# `just test integration-ratelimits` raises them for its run.
CASH_WALLET_RATE_LIMIT_PER_HOUR=0
CASH_WALLET_CLAIM_RATE_LIMIT_PER_HOUR=0
CIRCLE_WALLET_RATE_LIMIT_PER_HOUR=0

# Restarts the backend on an emptied relay (TestCircleMembershipAudit_RestartKeepsRemovedMemberOut).
INTEGRATION_RESTART_CMD="just dev restart-empty-relay"

# Logging
#Level 4 = Info, 5 = Debug
#LOG_LEVEL=4
#LOG_TO_FILE=true
#LOG_DB_QUERIES=false

# Security & Setup
#AUTO_UNLOCK_PASSWORD=
#ENABLE_ADVANCED_SETUP=true

# Services Configuration
#RELAY=wss://relay.ohstr.com
#MEMPOOL_API=https://flokichain.info/api
#SWAP_SERVICE_URL=
#LOKIHUB_SERVICES_URL=https://raw.githubusercontent.com/flokiorg/lokihub-services/refs/heads/main
#LOKIHUB_STORE_URL=https://raw.githubusercontent.com/flokiorg/lokihub-store/refs/heads/main
#MESSAGEBOARD_NWC_URL=

#ENABLE_SWAP=true
#ENABLE_MESSAGEBOARD_NWC=true

# FLND Configuration (Optional)
#LN_BACKEND_TYPE=FLND
#FLND_ADDRESS=
#FLND_CERT_FILE=
#FLND_MACAROON_FILE=

# Debugging
#GO_PROFILER_ADDR=
