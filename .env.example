# Pins the Go toolchain version go.mod requires (go 1.26.10), so `just`
# recipes that shell out to `go`/`wails` don't need GOTOOLCHAIN=go1.26.10
# typed on the command line every time.
GOTOOLCHAIN=go1.26.10

# General Configuration
#WORK_DIR=./data
#PORT=1610
#DATABASE_URI=nwc.db
#NETWORK=flokicoin   (the dev stack sets regtest)
#BASE_URL=http://localhost:1610
#FRONTEND_URL=http://localhost:5173

# NWC rate limits: 0 disables a limit (the code defaults are 10/20/3 per hour).
CASH_WALLET_RATE_LIMIT_PER_HOUR=0
CASH_WALLET_CLAIM_RATE_LIMIT_PER_HOUR=0
CIRCLE_WALLET_RATE_LIMIT_PER_HOUR=0

# Logging
#Level 4 = Info, 5 = Debug
#LOG_LEVEL=4
#LOG_TO_FILE=true
#LOG_DB_QUERIES=false

# Security & Setup
#AUTO_UNLOCK_PASSWORD=
#ENABLE_ADVANCED_SETUP=true

# Services Configuration
# The NWC relay the Hub dials (subscribes/publishes on):
#NWC_RELAY=wss://relay.ohstr.com
# The client-facing NWC relay advertised in pairing URIs / tokens / minted bills.
# Leave unset to advertise NWC_RELAY; set it when the dial URL is not reachable
# by clients (e.g. a docker-internal hostname):
#NWC_RELAY_ADVERTISED=wss://relay.ohstr.com
#MEMPOOL_API=https://flokichain.info/api
#LOKIHUB_STORE_URL=https://raw.githubusercontent.com/flokiorg/lokihub-store/refs/heads/main
# Override the built-in service seed (explorer/relay suggestions, currencies,
# FAQ, info and the fiat-rate oracle pointer) with an external YAML file:
#LOKIHUB_SEED_FILE=/etc/lokihub/seed.yaml

# Circles: the most a Circle Wallet Hub may keep as dust from a wallet it
# deletes (default 10000 mloki). The integration suite's ephemeral circles use
# a dust threshold of 100000000 to clean up after themselves, so a dev stack
# that runs it sets this to at least that.
#CIRCLE_MAX_DUST_MLOKI=100000000

# FLND Configuration (Optional)
#LN_BACKEND_TYPE=FLND
#FLND_ADDRESS=
# FLND_CERT_FILE pins the flnd node's TLS certificate. It is REQUIRED whenever
# FLND_ADDRESS is not a loopback address (e.g. the "flnd:10005" compose target):
# the admin macaroon is only sent over a verified TLS channel, so a non-loopback
# address without a pinned cert is refused. Only a loopback flnd (127.0.0.1 /
# localhost) may be dialed without it.
#FLND_CERT_FILE=
#FLND_MACAROON_FILE=

# Debugging
#GO_PROFILER_ADDR=
