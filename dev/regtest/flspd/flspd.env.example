# flspd's environment on lokihub's regtest stack (LP-13). See README.md.

# Required.
NODES_CONFIG_PATH=/flspd/nodes.yaml
DATABASE_URL=postgres://flspd:flspd@flspd-db:5432/flspd?sslmode=disable
AUTO_MIGRATE_DATABASE=true
# `just dev setup` writes data/regtest/flspd.env from this file with a fresh
# FLSPD_PRIVATE_KEY (64 hex; `flspd genkey` prints one too). Not the node key.
FLSPD_PRIVATE_KEY=
# The relays the announcement is published to and lists as r tags; required
# because announce.enabled is true.
NOSTR_ANNOUNCE_RELAYS=ws://relay:5500
# flspd's own gRPC API (channel opener, notifications).
LISTEN_ADDRESS=0.0.0.0:9090

# Optional.
# LSPS5 Nostr webhook transport: a hex or nsec key for the LSP's Nostr
# identity. Empty leaves only the https transport (LSPS5 stays listed).
LSP_NOSTR_PRIVATE_KEY=
# Operator dashboard (NIP-98 login by this pubkey).
DASHBOARD_ADMIN_PUBKEY=
DASHBOARD_LISTEN_ADDRESS=:8080
LSPS1_MAX_PENDING_ORDERS=50
LSPS5_MAX_WEBHOOKS=10
# Unset MEMPOOL_API_BASE_URL: fees come from flnd (lokihub's fees service).
LOG_DIR=/var/log/flspd
